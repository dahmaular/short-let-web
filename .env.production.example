# Frontend Environment Variables

# API Base URL
# For local development, use http://localhost:5001
# For production, use your deployed backend URL
VITE_API_URL=https://your-backend-api.vercel.app

# App URL (Your frontend deployment URL)
VITE_APP_URL=https://your-app.vercel.app

# Note: Paystack credentials are handled by the backend.
# The frontend does not need Paystack keys as all payment
# processing is done server-side for security.
