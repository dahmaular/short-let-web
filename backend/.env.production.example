# Production Environment Variables for Vercel Deployment

# Environment
NODE_ENV=production
PORT=5001

# API URL (Optional - for Swagger documentation)
# If not set, Swagger will automatically use VERCEL_URL
# Set this if you have a custom domain for your API
# API_URL=https://api.yourdomain.com

# MongoDB Atlas (Required - Get from https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/short-let-db?retryWrites=true&w=majority

# JWT Secret (Required - Generate a strong random string)
JWT_SECRET=your_production_jwt_secret_min_32_characters_long
JWT_EXPIRE=7d

# Cloudinary (Required for image uploads - Get from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (Required for notifications - Gmail or other SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourapp.com

# Paystack Payment Gateway (Required - Get from https://dashboard.paystack.com)
# For production, use LIVE keys (sk_live_xxx and pk_live_xxx)
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key

# Frontend URL (Required - Your Vercel frontend deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# Stripe (Optional - if you want to support Stripe payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
