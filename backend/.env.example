# Environment Variables
NODE_ENV=development
PORT=5000

# API URL (Optional - for Swagger documentation)
# If not set, Swagger will use localhost or VERCEL_URL automatically
# API_URL=https://your-backend-api.vercel.app

# MongoDB
MONGODB_URI=mongodb://localhost:27017/codakraft-apartment

# For production, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/codakraft-apartment
# mongodb+srv://dahmaular_db_user:ySuHaJecxaIcMeow@cluster0.kr1su6o.mongodb.net/?appName=Cluster0

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer - using Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@codakraft-apartment.com

# Paystack Payment (Get from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_486089d021f1bc986b3edcbd1800064e28ee6fea
PAYSTACK_PUBLIC_KEY=pk_test_5487f4b483ff702839cf7d82f411acc34a57eac8

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
